<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ReflavorAccents</AssemblyName>
    <!-- The plugin icon (Data/icon.png) at 16-256 px. Sets the .exe icon in Explorer. -->
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Same file for the window and taskbar. -->
    <EmbeddedResource Include="icon.ico" LogicalName="icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same accent engine as the plugin, without its Dalamud dependencies. -->
    <Compile Include="..\ReflavorRP\Accent.cs" Link="Accent.cs" />
  </ItemGroup>

</Project>
