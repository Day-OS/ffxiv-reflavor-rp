<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.0.0.1</Version>
    <!-- Manifest fields (see https://github.com/goatcorp/DalamudPackager/blob/827d88dc/DalamudPackager/DalamudPackager.cs#L420) -->
    <Author>Day-OS</Author>
    <Name>ReflavorRP</Name>
    <Punchline>SA-MP / GTA World style RP chat commands for FFXIV.</Punchline>
    <Description>Type RP the way you would on SA-MP or GTA World (/me, /s, /low, /w, /b, *actions*) and it is rewritten into FFXIV RP style emotes and speech.</Description>
    <RepoUrl>https://github.com/Day-OS/ffxiv-sampstyled-rp</RepoUrl>
    <IconUrl>https://raw.githubusercontent.com/Day-OS/ffxiv-sampstyled-rp/master/Data/icon.png</IconUrl>
    <Tags>rp;roleplay;chat;emote</Tags>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\Data\logo.png" LogicalName="ReflavorRP.Logo.png" />
    <EmbeddedResource Include="..\Data\Audio\speech-notification.pcm" LogicalName="ReflavorRP.SpeechNotification.pcm" />
    <Reference Include="TerraFX.Interop.Windows" HintPath="$(DalamudLibPath)TerraFX.Interop.Windows.dll" Private="false" />
    <None Include="..\Data\Audio\ATTRIBUTION.md" Link="Audio/ATTRIBUTION.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Data\Audio\CC-BY-NC-SA-3.0.txt" Link="Audio/CC-BY-NC-SA-3.0.txt" CopyToOutputDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="ReflavorRP.Tests" />
  </ItemGroup>
</Project>
